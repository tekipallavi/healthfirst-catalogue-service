@CatalogueService.Api_HostAddress = http://localhost:5284

### health check
GET {{CatalogueService.Api_HostAddress}}/health/dbcheck
Accept: application/json

### Get all products
GET {{CatalogueService.Api_HostAddress}}/api/products?search=07&sortBy=price&sortOrder=desc
Accept: application/json

### Create a product
# @name createProduct
POST {{CatalogueService.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Laptop",
  "description": "A complex wireless laptop",
  "price": 299.99,
  "status": "Active"
}

### Get a product by ID
GET {{CatalogueService.Api_HostAddress}}/api/products/{{createProduct.response.body.$.id}}
Accept: application/json

### Product not found
GET {{CatalogueService.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000000
Accept: application/json

### Invalid product request
POST {{CatalogueService.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "",
  "description": "",
  "price": 0
}

### Seed products (Development only)
# @name seedProducts
POST {{CatalogueService.Api_HostAddress}}/api/seed?count=999
Accept: application/json
